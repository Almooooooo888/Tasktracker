LK_JIRA_BASE_URL=https://jira.example.com
LK_JIRA_TLS_SKIP_VERIFY=false
# Необязательно: токен GitLab с read_api только для чтения MR
LK_GITLAB_BASE_URL=https://gitlab.example.com
LK_GITLAB_TOKEN=
# Диагностика обращений: адрес и read-only пользователь БД.
# Пароль LK_PG_PASSWORD задавай в окружении хоста или в настройках профиля,
# не записывай его в этот файл.
LK_PG_HOST=postgres.example.com
LK_PG_USER=readonly-user
# For an internal Jira CA, put the public CA certificate at certs/jira-ca.pem
# and uncomment this line:
# Для сертификатов Jira и GitLab:
# NODE_EXTRA_CA_CERTS=/run/certs/jira-ca.pem
